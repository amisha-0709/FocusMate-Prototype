  "dependencies": {
    "@clerk/clerk-js": "^6.36.0",
    "@clerk/express": "^2.1.74",
    "@clerk/shared": "^4.37.1",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
