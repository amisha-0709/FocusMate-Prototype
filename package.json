{
  "name": "workspace",
  "version": "1.0.0",
  "description": "A clickable prototype of **FocusMate**, an AI-powered study app that turns focused study time into measurable progress.",
  "main": "auth-server.ts",
  "scripts": {
    "build:auth": "esbuild auth-client.js --bundle --minify --platform=browser --format=iife --target=es2020 --outfile=auth-client.bundle.js",
    "start": "npm run build:auth && tsx auth-server.ts",
    "test": "python3 -m unittest -v test_server && node test_client_ai.js && npm run build:auth && python3 -m py_compile server.py test_server.py && git diff --check"
  },
